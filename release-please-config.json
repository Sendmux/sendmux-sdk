{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "sequential-calls": true,
  "separate-pull-requests": true,
  "always-update": true,
  "always-link-local": true,
  "plugins": [
    {
      "type": "node-workspace"
    }
  ],
  "group-pull-request-title-pattern": "chore: release ${branch}",
  "packages": {
    "packages/ts/core": {
      "component": "ts-core",
      "package-name": "@sendmux/core",
      "initial-version": "1.0.0"
    },
    "packages/ts/sending": {
      "component": "ts-sending",
      "package-name": "@sendmux/sending",
      "initial-version": "1.0.0"
    },
    "packages/ts/mailbox": {
      "component": "ts-mailbox",
      "package-name": "@sendmux/mailbox",
      "initial-version": "1.0.0"
    },
    "packages/ts/management": {
      "component": "ts-management",
      "package-name": "@sendmux/management",
      "initial-version": "1.0.0"
    },
    "packages/ts/sdk": {
      "component": "ts-sdk",
      "package-name": "@sendmux/sdk",
      "initial-version": "1.0.0"
    },
    "packages/ts/cli": {
      "component": "ts-cli",
      "package-name": "@sendmux/cli",
      "initial-version": "1.0.0"
    },
    "packages/python/core": {
      "component": "python-core",
      "package-name": "sendmux-core",
      "release-type": "python",
      "initial-version": "1.0.0"
    },
    "packages/python/sending": {
      "component": "python-sending",
      "package-name": "sendmux-sending",
      "release-type": "python",
      "initial-version": "1.0.0"
    },
    "packages/python/mailbox": {
      "component": "python-mailbox",
      "package-name": "sendmux-mailbox",
      "release-type": "python",
      "initial-version": "1.0.0"
    },
    "packages/python/management": {
      "component": "python-management",
      "package-name": "sendmux-management",
      "release-type": "python",
      "initial-version": "1.0.0"
    },
    "packages/python/sdk": {
      "component": "python-sdk",
      "package-name": "sendmux-sdk",
      "release-type": "python",
      "initial-version": "1.0.0"
    },
    "packages/python/mcp": {
      "component": "python-mcp",
      "package-name": "sendmux-mcp",
      "release-type": "python",
      "initial-version": "1.0.0",
      "extra-files": [
        {
          "type": "json",
          "path": "server.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "server.json",
          "jsonpath": "$.packages[0].version"
        }
      ]
    },
    "go": {
      "component": "go",
      "package-name": "sendmux.ai/go",
      "release-type": "go",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "/",
      "initial-version": "1.0.0"
    },
    "rust": {
      "component": "rust",
      "package-name": "sendmux",
      "release-type": "rust",
      "initial-version": "0.1.0"
    },
    "packages/ruby/core": {
      "component": "ruby-core",
      "package-name": "sendmux-core",
      "release-type": "ruby",
      "initial-version": "1.0.0"
    },
    "packages/ruby/sending": {
      "component": "ruby-sending",
      "package-name": "sendmux-sending",
      "release-type": "ruby",
      "initial-version": "1.0.0"
    },
    "packages/ruby/mailbox": {
      "component": "ruby-mailbox",
      "package-name": "sendmux-mailbox",
      "release-type": "ruby",
      "initial-version": "1.0.0"
    },
    "packages/ruby/management": {
      "component": "ruby-management",
      "package-name": "sendmux-management",
      "release-type": "ruby",
      "initial-version": "1.0.0"
    },
    "packages/ruby/sdk": {
      "component": "ruby-sdk",
      "package-name": "sendmux-sdk",
      "release-type": "ruby",
      "initial-version": "1.0.0"
    }
  }
}
